{
  "manifest_version": 3,
  "name": "千川商品本机连接",
  "version": "1.3.1",
  "description": "账户1000000000000000的商品采集及密码登录后逐次确认的计划操作；登录凭据留在原浏览器。",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://qianchuan.jinritemai.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/connect.html*"
      ],
      "js": [
        "connect-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
